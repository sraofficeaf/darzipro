#!/bin/sh
# .githooks/pre-push: Verifies Flutter web release compilation before allowing push

echo "=========================================================="
echo " [GIT PRE-PUSH HOOK] Verifying Flutter web build..."
echo "=========================================================="

flutter build web --release
BUILD_EXIT=$?

if [ $BUILD_EXIT -ne 0 ]; then
  echo ""
  echo "❌ [PRE-PUSH REJECTED] 'flutter build web --release' failed (exit code $BUILD_EXIT)."
  echo "Fix compilation errors before pushing to remote."
  echo ""
  exit 1
fi

echo ""
echo "✅ [PRE-PUSH PASSED] Web release build compiled successfully."
echo "Proceeding with push..."
echo ""
exit 0
